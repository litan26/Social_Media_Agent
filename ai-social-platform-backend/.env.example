# ============================================================
# REQUIRED — AI post generation (Groq, OpenAI-compatible API)
# Get a free key at https://console.groq.com/keys
# Paste it below, then restart the server.
# ============================================================
GROQ_API_KEY=gsk_...
# Optional — override the default model (see https://console.groq.com/docs/models)
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================
# REQUIRED - AI image generation (Gemini)
# Get a key at https://aistudio.google.com/app/apikey
# ============================================================
GEMINI_API_KEY=
# Optional - override the default image model
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Server
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
CALLBACK_BASE=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_socialmedia
DB_POOL_SIZE=20
# Set to true when connecting to a managed/remote Postgres that requires SSL
PGSSL=false

# JWT
JWT_SECRET=your-super-secret-key-min-32-chars-long
JWT_EXPIRY=7d

# Initial superadmin (run: npm run db:seed-superadmin)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-now

# --- Social OAuth (live connect per user) ---
# Set keys for each platform you want users to connect.
# Callback (whitelist in each developer console):
#   http://localhost:3000/oauth/callback/{platform}
# TOKEN_ENCRYPTION_KEY = 64-char hex (optional; else ENCRYPTION_KEY via scrypt)
# TOKEN_KEY=

# Twitter — https://developer.twitter.com/
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# TWITTER_BEARER_TOKEN=

# Instagram API with Instagram Login (standalone — no Facebook Page needed).
# Meta app > Instagram > API setup with Instagram login. Use the *Instagram*
# app ID/secret from that panel, NOT the Facebook app id.
# The connected account must be a Professional (Business/Creator) account.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# LinkedIn — https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Facebook Pages (classic Facebook Login) — https://developers.facebook.com/
# Publishes to a Facebook Page. Separate flow from Instagram above.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# TikTok — https://developers.tiktok.com/
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Pinterest — https://developers.pinterest.com/
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# YouTube (Google OAuth) — https://console.cloud.google.com/
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# YouTube Data API v3 key — powers live trending topics (/api/trends).
# Enable "YouTube Data API v3" at console.cloud.google.com/apis/library first,
# otherwise requests fail with API_KEY_SERVICE_BLOCKED.
YOUTUBE_API_KEY=
YOUTUBE_REGION=US

# Encryption (32+ chars)
ENCRYPTION_KEY=your-encryption-key-32-chars-min
