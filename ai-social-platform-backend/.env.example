# Server
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
CALLBACK_BASE=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# MySQL Database (AI_Socialmedia) — root, no password
DATABASE_URL=mysql://root@localhost:3306/AI_Socialmedia
DB_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-key-min-32-chars-long
JWT_EXPIRY=7d

# Initial superadmin (run: npm run db:seed-superadmin)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-now

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# --- Social OAuth (live connect per user) ---
# Set keys for each platform you want users to connect.
# Callback (whitelist in each developer console):
#   http://localhost:3000/oauth/callback/{platform}
# TOKEN_ENCRYPTION_KEY = 64-char hex (optional; else ENCRYPTION_KEY via scrypt)
# TOKEN_KEY=

# Twitter — https://developer.twitter.com/
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# TWITTER_BEARER_TOKEN=

# Instagram Basic Display — https://developers.facebook.com/docs/instagram-basic-display-api
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# LinkedIn — https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Facebook — https://developers.facebook.com/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# TikTok — https://developers.tiktok.com/
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Pinterest — https://developers.pinterest.com/
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# YouTube (Google OAuth) — https://console.cloud.google.com/
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Encryption (32+ chars)
ENCRYPTION_KEY=your-encryption-key-32-chars-min
